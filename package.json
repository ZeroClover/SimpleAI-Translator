{
  "name": "simpleai-translator",
  "version": "1.6.0",
  "description": "SimpleAI Translator",
  "packageManager": "pnpm@9.1.3",
  "scripts": {
    "prepare": "pnpm exec simple-git-hooks",
    "build-tauri-renderer": "tsc && vite build -c vite.config.tauri.ts",
    "dev-tauri-renderer": "vite -c vite.config.tauri.ts --force",
    "build-tauri": "npm run build-tauri-renderer && tauri build",
    "build-tauri-no-updater": "npm run build-tauri-renderer && tauri build --config src-tauri/tauri.production-no-updater.conf.json",
    "dev-tauri": "tauri dev",
    "dev-chromium": "wxt -b chromium",
    "dev-firefox": "wxt -b firefox",
    "build-browser-extension": "tsc && make build-browser-extension",
    "clean": "make clean",
    "check:no-telemetry": "scripts/check-no-telemetry.sh",
    "check:no-old-identity": "scripts/check-no-old-identity.sh",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --cache",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md,json}\" --cache"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint \"src/**/*.{ts,tsx}\" --cache",
      "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md,json}\" --cache"
    ]
  },
  "author": "",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZeroClover/SimpleAI-Translator.git"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.5.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@types/color": "^3.0.6",
    "@types/react-copy-to-clipboard": "^5.0.4",
    "baseui-sd": "^12.2.4",
    "best-effort-json-parser": "^1.0.1",
    "clsx": "^1.2.1",
    "color": "^4.2.3",
    "common-tags": "^1.8.2",
    "dequal": "^2.0.3",
    "dexie": "^3.2.3",
    "dexie-react-hooks": "^1.1.3",
    "edge-tts-universal": "^1.4.0",
    "eventsource-parser": "^1.0.0",
    "i18next": "^23.4.4",
    "i18next-browser-languagedetector": "^7.1.0",
    "iso-639-1": "^3.0.1",
    "jss": "^10.10.0",
    "jss-preset-default": "^10.10.0",
    "lodash.debounce": "^4.0.8",
    "lru-cache": "^10.0.1",
    "rc-field-form": "^1.36.0",
    "react": "^18.2.0",
    "react-copy-to-clipboard": "^5.1.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.5",
    "react-error-boundary": "^4.0.10",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^13.0.3",
    "react-icons": "^5.0.1",
    "react-jss": "^10.10.0",
    "react-markdown": "^10",
    "styletron-engine-atomic": "^1.5.0",
    "styletron-react": "^6.1.0",
    "swr": "^2.2.0",
    "use-deep-compare": "^1.1.0",
    "uuid": "^14.0.0",
    "web-streams-polyfill": "^4.2.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/chrome": "0.3.5",
    "@types/common-tags": "^1.8.4",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "^18.2.18",
    "@types/react-dom": "^18.2.7",
    "@types/webextension-polyfill": "^0.10.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "webextension-polyfill": "^0.10.0",
    "wxt": "^0.21.4"
  }
}
