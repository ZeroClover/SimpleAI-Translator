{
  "name": "simpleai-translator",
  "version": "1.7.0",
  "description": "SimpleAI Translator",
  "packageManager": "pnpm@9.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "pnpm exec simple-git-hooks",
    "build-tauri-renderer": "tsc && vite build -c vite.config.tauri.ts",
    "dev-tauri-renderer": "vite -c vite.config.tauri.ts --force",
    "build-tauri": "npm run build-tauri-renderer && tauri build",
    "build-tauri-no-updater": "npm run build-tauri-renderer && tauri build --config src-tauri/tauri.production-no-updater.conf.json",
    "dev-tauri": "tauri dev",
    "dev-chromium": "wxt -b chromium",
    "dev-firefox": "wxt -b firefox",
    "build-browser-extension": "tsc && make build-browser-extension",
    "clean": "make clean",
    "check:no-telemetry": "scripts/check-no-telemetry.sh",
    "check:no-old-identity": "scripts/check-no-old-identity.sh",
    "test:e2e": "playwright test",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --cache",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md,json}\" --cache"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint \"src/**/*.{ts,tsx}\" --cache",
      "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md,json}\" --cache"
    ]
  },
  "author": "",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZeroClover/SimpleAI-Translator.git"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "baseui": "^18.2.0",
    "best-effort-json-parser": "^1.5.1",
    "clsx": "^2.1.1",
    "color": "^5.0.3",
    "common-tags": "^1.8.2",
    "dequal": "^2.0.3",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "edge-tts-universal": "^1.4.0",
    "eventsource-parser": "^4.1.2",
    "i18next": "^26.5.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "iso-639-1": "^3.1.6",
    "jss": "^10.10.0",
    "jss-preset-default": "^10.10.0",
    "lodash.debounce": "^4.0.8",
    "lru-cache": "^11.5.3",
    "rc-field-form": "^2.7.1",
    "react": "^19.3.1",
    "react-copy-to-clipboard": "^5.1.1",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.3.1",
    "react-draggable": "^4.7.2",
    "react-error-boundary": "^6.1.6",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.1.0",
    "react-icons": "^5.7.0",
    "react-jss": "^10.10.0",
    "react-markdown": "^10.1.0",
    "styletron-engine-atomic": "^1.6.2",
    "styletron-react": "^6.1.1",
    "swr": "^2.5.1",
    "use-deep-compare": "^1.3.0",
    "uuid": "^14.0.3",
    "web-streams-polyfill": "^4.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/chrome": "0.3.5",
    "@types/common-tags": "^1.8.4",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "webextension-polyfill": "^0.12.0",
    "wxt": "^0.21.4"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0"
    },
    "patchedDependencies": {
      "baseui@18.2.0": "patches/baseui@18.2.0.patch"
    }
  }
}
