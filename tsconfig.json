{
    "compilerOptions": {
        "strict": true,
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "allowJs": false,
        "useDefineForClassFields": true,
        "module": "ESNext",
        "target": "es2017",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": false,
        "rootDir": ".",
        "outDir": "dist/js",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noEmitOnError": true,
        "jsx": "react-jsx",
        "typeRoots": ["node_modules/@types/", "node_modules"],
        "resolveJsonModule": true,
        "types": ["vite/client", "chrome", "node"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "src-tauri", "vite.config*.ts", "wxt.config.ts", "eslint.config.js", "playwright.config.ts", "e2e"]
}
